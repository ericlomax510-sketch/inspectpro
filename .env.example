# Example environment variables and runtime config

# .env.example
# Do NOT commit real secret values. Use GitHub Actions secrets or your CI provider's secret store.

# Stripe publishable key (client-side). Use a publishable key only; never embed secret keys in client JS.
INSPECTPRO_STRIPE_PK=pk_test_xxx

# Server-side booking endpoint (your backend that charges a payment method)
INSPECTPRO_BOOKING_ENDPOINT=https://example.com/api/charge-booking-fee
INSPECTPRO_BOOKING_PRICE_ID=price_xxx
INSPECTPRO_BOOKING_FEE_LABEL="$3.00 booking fee"

# Example: provide these values to your CI and inject them at build-time into window.INSPECTPRO_CONFIG
