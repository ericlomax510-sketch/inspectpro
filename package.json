{
  "name": "inspectpro",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper for InspectPro web app",
  "scripts": {
    "build:web": "node scripts/build-www.js",
    "prepare:web": "npm run build:web",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "install:plugins": "npm install @capacitor/camera @capacitor/filesystem @capacitor/splash-screen @capacitor/status-bar @capacitor/geolocation && npx cap sync"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^5.0.0",
    "@capacitor/camera": "^5.0.0",
    "@capacitor/filesystem": "^5.0.0",
    "@capacitor/splash-screen": "^5.0.0",
    "@capacitor/status-bar": "^5.0.0",
    "@capacitor/geolocation": "^5.0.0"
  }
}
